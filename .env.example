# 선택적 Google Cloud 감성 분석: 컨테이너 내부의 인증 파일 경로.
# KoELECTRA 추론과 별도로 사용하는 과거 선택 기능이다.
# ENABLE_CLOUD_NLP는 기존 코드에서 사용하지 않으므로 제공하지 않는다.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-credentials.json

# 기본 저장소는 MySQL. 로컬 Python은 호스트 포트, Compose 내부는 ai-db:3306 사용.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_HOST_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=review_system
# 기존 볼륨의 비밀번호는 .env 수정만으로 변경되지 않는다.
# root는 기존 로컬 구성 호환용. 운영에서는 별도 최소 권한 계정을 생성해 사용한다.
# 공개 계약과 인증 확정 전에는 아래 기능을 운영 환경에서 켜지 않는다.
ENABLE_EXPERIMENTAL_COLLECTION=0
# 내부 분석/실험 API 인증. 토큰 미설정은 로컬 호환 모드, 운영은 REQUIRE=1 필수.
REQUIRE_INTERNAL_TOKEN=0
INTERNAL_TOKEN=
# Data로 보내는 토큰. 비어 있으면 INTERNAL_TOKEN을 재사용한다.
DATA_INTERNAL_TOKEN=
# Data 서버의 확정 HTTPS 주소. 인증 토큰이 있으면 HTTP 주소로 실행 불가.
DATA_SERVER_BASE_URL=
# 실험 시 실제 크롤러 서비스 주소를 명시한다 (우리 AI 서버 주소가 아님).
# DATA_SERVER_BASE_URL이 비어 있을 때만 아래 과거 이름을 사용한다.
# CRAWLER_BASE_URL=http://crawler:8000
# CRAWLER_STREAM_TIMEOUT=60
# CRAWLER_MAX_RETRIES=0

# KoELECTRA 최종 모델은 Git/이미지에 포함하지 않고 호스트 폴더에서 읽는다.
# host 값은 config.json/model.safetensors/tokenizer 파일 등이 있는 실제 디렉터리.
# 없는 host 경로는 Compose 기동 시 오류로 처리하며 자동 생성하지 않는다.
PTEXT_MODEL_HOST_PATH=./models/ptext-koelectra-v1-2epoch-20260929
# Compose 컨테이너 내부 경로. 로컬 Python 실행 시에는 실제 모델 폴더 경로로 설정한다.
PTEXT_MODEL_PATH=/models/ptext-koelectra-v1-2epoch-20260929
# worker는 Dockerfile에서 1개 고정. CPU 추론 스레드만 아래에서 제한한다.
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2

# 선택적 Groq 설명 후처리. 점수는 변경하지 않으며 미설정/실패 시 reason code를 유지한다.
# 실제 키는 로컬/운영 .env에만 설정하고 Git에 저장하지 않는다.
ENABLE_GROQ_REASON_NATURALIZATION=0
GROQ_API_KEY_PRIMARY=
GROQ_API_KEY_SECONDARY=
# strict JSON schema 출력을 지원하는 모델을 운영 활성화 전에 명시한다.
GROQ_MODEL=
GROQ_TIMEOUT_SECONDS=5
